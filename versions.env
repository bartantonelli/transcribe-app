# Pinned upstream versions used by build.sh.
# Bump these together when you re-lock requirements.

# Portable Python interpreter (arm64 macOS) from python-build-standalone.
PYTHON_VERSION="3.11.15"
PYTHON_RELEASE="20260510"
PYTHON_URL="https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_RELEASE}/cpython-${PYTHON_VERSION}+${PYTHON_RELEASE}-aarch64-apple-darwin-install_only.tar.gz"

# whisper-diarization (the pipeline script we wrap).
WD_REPO="https://github.com/MahmoudAshraf97/whisper-diarization.git"
WD_COMMIT="8d87f2e14753c279433b521e02932a6fccc8919d"

# Models. Pinned so the same artefacts come down every time.
WHISPER_MODEL="medium.en"
HF_FASTER_WHISPER="Systran/faster-whisper-medium.en"
HF_FORCED_ALIGNER="MahmoudAshraf/mms-300m-1130-forced-aligner"
HF_PUNCTUATION="kredor/punctuate-all"

# Speaker models (pyannote in Core ML) for the speaker-native tool. The Swift
# dependency that runs them is pinned in native/Package.swift.
SPEAKERKIT_REVISION="556fc52a13327837688f02289457cded017802e9"

# Build-time only (draws the app icon); not bundled.
PILLOW_VERSION="12.2.0"
